{
  "name": "smartbid-docs-skillset",
  "description": "Rebuilds each document's outline as Markdown and chunks it per section instead of every N characters, so a specification table stays with its heading and the page header/footer that repeats on every page is dropped. The embedded text carries the catalogue metadata; the stored chunk keeps the readable Markdown.",
  "skills": [
    {
      "@odata.type": "#Microsoft.Skills.Custom.WebApiSkill",
      "name": "section-chunk-skill",
      "description": "Section-aware Markdown chunking (Function App: POST /api/skills/chunk).",
      "context": "/document",
      "uri": "https://fa-opgb-bes-prd-fa.azurewebsites.net/api/skills/chunk",
      "httpMethod": "POST",
      "timeout": "PT3M50S",
      "batchSize": 1,
      "degreeOfParallelism": 2,
      "authResourceId": "api://opgbbes-prd-fa-aadapp.oceaneering.com",
      "inputs": [
        {
          "name": "content",
          "source": "/document/content"
        },
        {
          "name": "title",
          "source": "/document/metadata_spo_item_name"
        },
        {
          "name": "docType",
          "source": "/document/DocType"
        },
        {
          "name": "docCategory",
          "source": "/document/DocCategory"
        },
        {
          "name": "manufacturer",
          "source": "/document/Manufacturer"
        },
        {
          "name": "docModel",
          "source": "/document/DocModel"
        },
        {
          "name": "docKeywords",
          "source": "/document/DocKeywords"
        },
        {
          "name": "docDescription",
          "source": "/document/DocDescription"
        },
        {
          "name": "docRevision",
          "source": "/document/DocRevision"
        }
      ],
      "outputs": [
        {
          "name": "chunks",
          "targetName": "chunks"
        }
      ]
    },
    {
      "@odata.type": "#Microsoft.Skills.Text.AzureOpenAIEmbeddingSkill",
      "name": "embedding-skill",
      "context": "/document/chunks/*",
      "resourceUri": "https://cog-opgbbes-openai-prd.openai.azure.com",
      "deploymentId": "text-embedding-3-small",
      "dimensions": 1536,
      "modelName": "text-embedding-3-small",
      "inputs": [
        {
          "name": "text",
          "source": "/document/chunks/*/content",
          "inputs": []
        }
      ],
      "outputs": [
        {
          "name": "embedding",
          "targetName": "text_vector"
        }
      ]
    }
  ],
  "indexProjections": {
    "selectors": [
      {
        "targetIndexName": "smartbid-docs-index",
        "parentKeyFieldName": "parent_id",
        "sourceContext": "/document/chunks/*",
        "mappings": [
          {
            "name": "chunk",
            "source": "/document/chunks/*/text",
            "inputs": []
          },
          {
            "name": "text_vector",
            "source": "/document/chunks/*/text_vector",
            "inputs": []
          },
          {
            "name": "sectionPath",
            "source": "/document/chunks/*/section",
            "inputs": []
          },
          {
            "name": "title",
            "source": "/document/metadata_spo_item_name",
            "inputs": []
          },
          {
            "name": "sourceUrl",
            "source": "/document/metadata_spo_item_weburi",
            "inputs": []
          },
          {
            "name": "filePath",
            "source": "/document/metadata_spo_item_path",
            "inputs": []
          },
          {
            "name": "lastModified",
            "source": "/document/metadata_spo_item_last_modified",
            "inputs": []
          },
          {
            "name": "docType",
            "source": "/document/DocType",
            "inputs": []
          },
          {
            "name": "docCategory",
            "source": "/document/DocCategory",
            "inputs": []
          },
          {
            "name": "manufacturer",
            "source": "/document/Manufacturer",
            "inputs": []
          },
          {
            "name": "docModel",
            "source": "/document/DocModel",
            "inputs": []
          },
          {
            "name": "docKeywords",
            "source": "/document/DocKeywords",
            "inputs": []
          },
          {
            "name": "docDescription",
            "source": "/document/DocDescription",
            "inputs": []
          },
          {
            "name": "docRevision",
            "source": "/document/DocRevision",
            "inputs": []
          }
        ]
      }
    ],
    "parameters": {
      "projectionMode": "skipIndexingParentDocuments"
    }
  }
}
