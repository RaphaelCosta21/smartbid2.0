{
  "name": "smartbid-docs-indexer",
  "description": "Crawls smartBidDocs (Datasheets incl. the Technical Proposals subfolder, Manuals and Catalogs, Past Bids, and Clarifications Library) into smartbid-docs-index.",
  "dataSourceName": "smartbid-docs-datasource",
  "skillsetName": "smartbid-docs-skillset",
  "targetIndexName": "smartbid-docs-index",
  "disabled": null,
  "schedule": {
    "interval": "PT6H",
    "startTime": "2026-08-22T03:00:00Z"
  },
  "parameters": {
    "batchSize": 10,
    "maxFailedItems": 10,
    "maxFailedItemsPerBatch": 10,
    "configuration": {
      "indexedFileNameExtensions": ".pdf,.docx,.doc,.pptx,.xlsx,.txt,.md",
      "excludedFileNameExtensions": ".png,.jpg,.jpeg,.gif",
      "dataToExtract": "contentAndMetadata",
      "failOnUnsupportedContentType": false,
      "failOnUnprocessableDocument": false,
      "indexStorageMetadataOnlyForOversizedDocuments": true
    }
  },
  "fieldMappings": [],
  "outputFieldMappings": [],
  "cache": null,
  "encryptionKey": null
}
