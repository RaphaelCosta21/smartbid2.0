{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.4",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "📊 Status da Aprovação",
              "weight": "Bolder",
              "size": "Large"
            },
            {
              "type": "TextBlock",
              "text": "[[BID_NUMBER]] · [[CLIENT]]",
              "isSubtle": true,
              "spacing": "None",
              "wrap": true
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "[[STATUS_BADGE]]",
              "weight": "Bolder",
              "horizontalAlignment": "Right",
              "wrap": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "[[PROGRESS_BAR]]  **[[APPROVED_COUNT]]/[[TOTAL_COUNT]]**",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "Container",
      "separator": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "[[APPROVER_LIST_MD]]",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "🕒 Atualizado em [[UPDATED_AT]]",
      "isSubtle": true,
      "size": "Small",
      "horizontalAlignment": "Right",
      "wrap": true
    }
  ]
}
